# Copy this file to backend/.env and fill in the values (Member 1 sends the real ones privately).
# Never commit backend/.env.

# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Database (shared MongoDB Atlas cluster) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/travel_platform

# --- Auth (Member 1) ---
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me

# Admin seed (ACC-18): npm run seed:admin
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@travel.com
ADMIN_PASSWORD=change_me_123

# --- Payments (Member 4, Stripe test mode) ---
PLATFORM_CURRENCY=USD
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Exchange rates (Member 2, https://fxratesapi.com/) ---
FXRATES_API_KEY=your_fxrates_api_key
